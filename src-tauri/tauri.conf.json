{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Flowtape Studio",
  "version": "0.1.1",
  "identifier": "com.flowtape.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 5174 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Flowtape Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "minimumSystemVersion": "10.13",
      "infoPlist": "Info.plist",
      "signingIdentity": "Developer ID Application: Sandro Ieva (H5J8Z2KAS6)"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxNjVEODE1MTIzOTEzMDUKUldRRkV6a1NGZGhsTWI2MFlYZmt2bHFVUWRZRWlNMTkzZ0hoZW15UjZLSHhpYlgvYUswcVZoRGIK",
      "endpoints": [
        "https://github.com/SandroIeva/flowtape/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
